# Copia a .env y reemplaza los valores de ejemplo. .env esta excluido de Git.

# Contenedor PostgreSQL (docker-compose.yml)
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=change_me

# Conexion de datos de Spring Boot (apps/backend/src/main/resources/application.properties)
DB_URL=jdbc:postgresql://localhost:5432/catalog
DB_USERNAME=catalog
DB_PASSWORD=change_me
